{
  "info": {
    "name": "ETMS Auth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Authentication and RBAC-ready contract for ETMS."
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n  pm.response.to.have.status(200);\n});",
              "const json = pm.response.json();",
              "pm.expect(json.success).to.equal(true);",
              "pm.collectionVariables.set(\"accessToken\", json.data.accessToken);",
              "pm.collectionVariables.set(\"refreshToken\", json.data.refreshToken);",
              "pm.collectionVariables.set(\"userId\", json.data.user.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@etms.com\",\n  \"password\": \"Admin@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "Get Current User",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "me"]
        }
      }
    },
    {
      "name": "Get Permissions",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/permissions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "permissions"]
        }
      }
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "refresh"]
        }
      }
    },
    {
      "name": "Forgot Password - Valid Email",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n  pm.response.to.have.status(200);\n});",
              "const json = pm.response.json();",
              "pm.expect(json.success).to.equal(true);",
              "pm.expect(json.message).to.equal(\"If the account exists, reset instructions have been sent\");",
              "pm.expect(json.token).to.be.undefined;",
              "pm.expect(json.resetToken).to.be.undefined;"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@etms.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "forgot-password"]
        }
      }
    },
    {
      "name": "Forgot Password - Invalid Email",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n  pm.response.to.have.status(200);\n});",
              "const json = pm.response.json();",
              "pm.expect(json.success).to.equal(true);",
              "pm.expect(json.message).to.equal(\"If the account exists, reset instructions have been sent\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nonexistent@etms.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "forgot-password"]
        }
      }
    },
    {
      "name": "Reset Password - Invalid Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () {\n  pm.response.to.have.status(400);\n});",
              "const json = pm.response.json();",
              "pm.expect(json.success).to.equal(false);",
              "pm.expect(json.code).to.equal(\"RESET_TOKEN_INVALID\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"invalid-token-12345\",\n  \"newPassword\": \"NewPass@123\",\n  \"confirmPassword\": \"NewPass@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "reset-password"]
        }
      }
    },
    {
      "name": "Reset Password - Expired Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () {\n  pm.response.to.have.status(400);\n});",
              "const json = pm.response.json();",
              "pm.expect(json.success).to.equal(false);",
              "pm.expect(json.code).to.equal(\"RESET_TOKEN_INVALID\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"expired-token-12345\",\n  \"newPassword\": \"NewPass@123\",\n  \"confirmPassword\": \"NewPass@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "reset-password"]
        }
      }
    },
    {
      "name": "Reset Password - Used Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () {\n  pm.response.to.have.status(400);\n});",
              "const json = pm.response.json();",
              "pm.expect(json.success).to.equal(false);",
              "pm.expect(json.code).to.equal(\"RESET_TOKEN_INVALID\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"already-used-token-12345\",\n  \"newPassword\": \"NewPass@123\",\n  \"confirmPassword\": \"NewPass@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "reset-password"]
        }
      }
    },
    {
      "name": "Reset Password - Success",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const token = pm.collectionVariables.get('resetToken');",
              "if (!token) { throw new Error('Missing resetToken variable. Run Forgot Password first to generate a token in the app context.'); }"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n  pm.response.to.have.status(200);\n});",
              "const json = pm.response.json();",
              "pm.expect(json.success).to.equal(true);",
              "pm.expect(json.message).to.equal(\"Password reset successfully\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"NewPass@123\",\n  \"confirmPassword\": \"NewPass@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "reset-password"]
        }
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "logout"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string"
    }
  ]
}
