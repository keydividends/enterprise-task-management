{
  "info": {
    "name": "ETMS Role & Permission API Collection",
    "description": "REST API endpoints for Role and Permission management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Roles",
      "item": [
        {
          "name": "List All Roles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/roles?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "roles"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "isActive",
                  "value": "true",
                  "disabled": true
                }
              ]
            },
            "description": "Get list of all roles with pagination support"
          },
          "response": []
        },
        {
          "name": "Create Role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA_ENGINEER\",\n  \"description\": \"Quality Assurance Engineer role\",\n  \"permissionIds\": [\n    \"{{permissionId_1}}\",\n    \"{{permissionId_2}}\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/roles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "roles"]
            },
            "description": "Create a new role with specified permissions"
          },
          "response": []
        },
        {
          "name": "Get Role by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/roles/{{roleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "roles", "{{roleId}}"]
            },
            "description": "Get a specific role by ID"
          },
          "response": []
        },
        {
          "name": "Update Role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA_ENGINEER_SENIOR\",\n  \"description\": \"Senior Quality Assurance Engineer\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/roles/{{roleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "roles", "{{roleId}}"]
            },
            "description": "Update an existing role (cannot update system roles)"
          },
          "response": []
        },
        {
          "name": "Delete Role",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/roles/{{roleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "roles", "{{roleId}}"]
            },
            "description": "Delete a custom role (system roles cannot be deleted)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Permissions",
      "item": [
        {
          "name": "List All Permissions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/permissions?page=1&pageSize=50&module=TASK",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "permissions"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "50"
                },
                {
                  "key": "module",
                  "value": "TASK",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Get list of all available permissions with optional filters"
          },
          "response": []
        },
        {
          "name": "Get Role Permissions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/roles/{{roleId}}/permissions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "roles", "{{roleId}}", "permissions"]
            },
            "description": "Get all permissions assigned to a specific role"
          },
          "response": []
        },
        {
          "name": "Update Role Permissions",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissionIds\": [\n    \"{{permissionId_1}}\",\n    \"{{permissionId_2}}\",\n    \"{{permissionId_3}}\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/roles/{{roleId}}/permissions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "roles", "{{roleId}}", "permissions"]
            },
            "description": "Replace all permissions for a role (cannot update system roles)"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "your-jwt-token-here",
      "type": "string"
    },
    {
      "key": "roleId",
      "value": "role-id-here",
      "type": "string"
    },
    {
      "key": "permissionId_1",
      "value": "permission-id-1",
      "type": "string"
    },
    {
      "key": "permissionId_2",
      "value": "permission-id-2",
      "type": "string"
    },
    {
      "key": "permissionId_3",
      "value": "permission-id-3",
      "type": "string"
    }
  ]
}
